  {
    "id": "action_items",
    "instruction": "Extraia items: exatamente duas ações, na ordem, sem a numeração.",
    "source_text": "Ata sintética. Ações: (1) Publicar nota. (2) Arquivar rascunho.",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "ground_truth": {
      "items": [
        "Publicar nota",
        "Arquivar rascunho"
      ]
    },
    "model_key": "action_items",
    "rules": [
      {
        "op": "list_len",
        "field": "items",
        "minimum": 2,
        "maximum": 2
      },
      {
        "op": "text_length",
        "field": "items",
        "min_length": 1,
        "max_length": 80
      }
    ],
    "examples": {
      "malformed": "{\"items\": [\"Publicar nota\", \"Arquivar rascunho\"]",
      "subtle": "{\"items\": [\"Publicar nota\", \"Publicar nota\"]}"
    }
  },
  {
