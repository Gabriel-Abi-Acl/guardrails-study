[
  {
    "id": "invoice_total",
    "instruction": "Extraia invoice_id e total_cents. invoice_id como impresso. total_cents é inteiro, em centavos.",
    "source_text": "Documento sintético. Número da nota: INV-1042. Valor total: 1990 centavos.",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invoice_id",
        "total_cents"
      ],
      "properties": {
        "invoice_id": {
          "type": "string",
          "pattern": "^INV-\\d{4}$"
        },
        "total_cents": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ground_truth": {
      "invoice_id": "INV-1042",
      "total_cents": 1990
    },
    "model_key": "invoice_total",
    "rules": [
      {
        "op": "regex",
        "field": "invoice_id",
        "pattern": "^INV-\\d{4}$"
      },
      {
        "op": "type",
        "field": "total_cents",
        "json_type": "integer"
      },
      {
        "op": "gte",
        "field": "total_cents",
        "value": 0,
        "numeric": "integer"
      }
    ],
    "examples": {
      "malformed": "{\"invoice_id\": \"INV-1042\", \"total_cents\":",
      "subtle": "{\"invoice_id\": \"INV-1042\", \"total_cents\": 199}"
    }
  },
  {
    "id": "due_date",
    "instruction": "Extraia due_date no formato ISO-8601 (YYYY-MM-DD).",
    "source_text": "Boleto sintético. Data de vencimento: 28/02/2024.",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "due_date"
      ],
      "properties": {
        "due_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "ground_truth": {
      "due_date": "2024-02-28"
    },
    "model_key": "due_date",
    "rules": [
      {
        "op": "calendar_date",
        "field": "due_date"
      }
    ],
    "examples": {
      "malformed": "not json",
      "subtle": "{\"due_date\": \"2024-02-27\"}"
    }
  },
  {
    "id": "contact_email",
    "instruction": "Extraia email exatamente como escrito no texto.",
    "source_text": "Assinatura sintética. E-mail de contato: ada.study@example.com.",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        }
      }
    },
    "ground_truth": {
      "email": "ada.study@example.com"
    },
    "model_key": "contact_email",
    "rules": [
      {
        "op": "regex",
        "field": "email",
        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
      }
    ],
    "examples": {
      "malformed": "{\"email\": \"ada.study@example.com\",}",
      "subtle": "{\"email\": \"other.study@example.com\"}"
    }
  },
  {
    "id": "ticket_priority",
    "instruction": "Extraia priority (low, medium ou high; alta=high, média=medium, baixa=low) e sla_hours inteiro.",
    "source_text": "Chamado sintético. Prioridade alta. SLA de 4 horas.",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "sla_hours"
      ],
      "properties": {
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "sla_hours": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ground_truth": {
      "priority": "high",
      "sla_hours": 4
    },
    "model_key": "ticket_priority",
    "rules": [
      {
        "op": "enum",
        "field": "priority",
        "choices": [
          "low",
          "medium",
          "high"
        ]
      },
      {
        "op": "max_when_eq",
        "field": "sla_hours",
        "when_field": "priority",
        "when_value": "high",
        "value": 4
      }
    ],
    "examples": {
      "malformed": "{\"priority\": \"high\"",
      "subtle": "{\"priority\": \"medium\", \"sla_hours\": 4}"
    }
  },
  {
    "id": "line_item",
    "instruction": "Extraia sku, qty, unit_cents e total_cents. Valores monetários em centavos, inteiros.",
    "source_text": "Item sintético. Código SKU-100. Quantidade 2. Preço unitário 500 centavos. Total da linha 1000 centavos.",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "qty",
        "unit_cents",
        "total_cents"
      ],
      "properties": {
        "sku": {
          "type": "string",
          "pattern": "^SKU-\\d{3}$"
        },
        "qty": {
          "type": "integer",
          "minimum": 1
        },
        "unit_cents": {
          "type": "integer",
          "minimum": 0
        },
        "total_cents": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ground_truth": {
      "sku": "SKU-100",
      "qty": 2,
      "unit_cents": 500,
      "total_cents": 1000
    },
    "model_key": "line_item",
    "rules": [
      {
        "op": "regex",
        "field": "sku",
        "pattern": "^SKU-\\d{3}$"
      },
      {
        "op": "gte",
        "field": "qty",
        "value": 1,
        "numeric": "integer"
      },
      {
        "op": "product_equals",
        "factors": [
          "qty",
          "unit_cents"
        ],
        "product": "total_cents"
      }
    ],
    "examples": {
      "malformed": "[{\"sku\":",
      "subtle": "{\"qty\": 3, \"sku\": \"SKU-100\", \"total_cents\": 1500, \"unit_cents\": 500}"
    }
  },
  {
    "id": "phone_e164",
    "instruction": "Extraia phone em E.164, com + e só dígitos, sem espaço nem pontuação.",
    "source_text": "Contato sintético. Telefone: +55 11 90000-0000.",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phone"
      ],
      "properties": {
        "phone": {
          "type": "string",
          "pattern": "^\\+\\d{10,15}$"
        }
      }
    },
    "ground_truth": {
      "phone": "+5511900000000"
    },
    "model_key": "phone_e164",
    "rules": [
      {
        "op": "regex",
        "field": "phone",
        "pattern": "^\\+\\d{10,15}$"
      }
    ],
    "examples": {
      "malformed": "```json\n{\"phone\": \"+5511900000000\"}\n```",
      "subtle": "{\"phone\": \"+5511900000001\"}"
    }
  },
  {
    "id": "shipment_delayed",
    "instruction": "Extraia tracking como impresso e delayed booleano. No prazo significa delayed false.",
    "source_text": "Rastreio sintético TRK-9. O pacote está no prazo, sem atraso.",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delayed",
        "tracking"
      ],
      "properties": {
        "delayed": {
          "type": "boolean"
        },
        "tracking": {
          "type": "string",
          "pattern": "^TRK-\\d+$"
        }
      }
    },
    "ground_truth": {
      "delayed": false,
      "tracking": "TRK-9"
    },
    "model_key": "shipment_delayed",
    "rules": [
      {
        "op": "type",
        "field": "delayed",
        "json_type": "boolean"
      },
      {
        "op": "regex",
        "field": "tracking",
        "pattern": "^TRK-\\d+$"
      }
    ],
    "examples": {
      "malformed": "{\"delayed\": false, \"tracking\": \"TRK-9\"} trailing",
      "subtle": "{\"delayed\": true, \"tracking\": \"TRK-9\"}"
    }
  },
  {
