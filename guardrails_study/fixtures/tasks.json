      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "amount"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "enum": [
            "USD",
            "BRL",
            "EUR"
          ]
        },
        "amount": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ground_truth": {
