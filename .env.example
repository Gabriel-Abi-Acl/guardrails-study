# Provedor do gerador: fake, openai ou anthropic.
# fake não usa rede e é o que a suíte de testes exercita.
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=

# Revisor usado só pela estratégia second_llm.
CHECKER_PROVIDER=fake
CHECKER_MODEL=
CHECKER_API_KEY=

# Tentativas das estratégias que reperguntam (pydantic, rules, second_llm).
# json_schema permanece em 1 tentativa.
MAX_ATTEMPTS=3

# Teto de tokens de saída nos adaptadores ao vivo.
LLM_MAX_OUTPUT_TOKENS=1024

# USD por 1 milhão de tokens. Vazio deixa cost_usd null — o código não inventa preço.
PRICE_PROMPT_PER_MILLION=
PRICE_COMPLETION_PER_MILLION=
